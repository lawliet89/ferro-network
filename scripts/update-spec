#!/usr/bin/env bash
# Bump the pinned UniFi Network OpenAPI spec version.
#
# Usage:
#   scripts/update-spec               # prints available versions and exits
#   scripts/update-spec <VERSION>     # bumps to <VERSION> and runs the check suite
#
# Safe to re-run. On failure, leaves the working tree as-is so you can
# inspect the diff and re-run after a fix. See UPGRADING.md.

set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SUBMODULE="$REPO_ROOT/third_party/unifi-apis"
SPEC_DIR="$SUBMODULE/unifi-network"
BUILD_RS="$REPO_ROOT/crates/ferro-network/build.rs"
# README.md repeats the pinned version for users; kept in sync below.
README="$REPO_ROOT/README.md"
README_PATTERN='Targets Network application version \*\*[^*]+\*\*'

cd "$REPO_ROOT"

if [[ ! -d "$SUBMODULE/.git" && ! -f "$SUBMODULE/.git" ]]; then
  echo "error: submodule $SUBMODULE not initialized" >&2
  echo "  run: git submodule update --init --recursive" >&2
  exit 1
fi

current_version() {
  grep -oE 'const SPEC_VERSION: &str = "[^"]+"' "$BUILD_RS" \
    | sed -E 's/.*"(.+)".*/\1/'
}

available_versions() {
  # avoid GNU-only `sort -V` so this also runs on macOS; spec versions
  # are always MAJOR.MINOR.PATCH
  for f in "$SPEC_DIR"/*.json; do
    [[ -f "$f" ]] || continue
    f="${f##*/}"
    echo "${f%.json}"
  done | sort -t. -k1,1n -k2,2n -k3,3n
}

if [[ $# -eq 0 ]]; then
  # Listing is read-only: show what the checked-out submodule commit has.
  # Fetch first (`git -C third_party/unifi-apis fetch && git -C
  # third_party/unifi-apis checkout origin/HEAD`) to see newer specs.
  echo "Currently pinned: $(current_version)"
  echo "Submodule at:     $(git -C "$SUBMODULE" rev-parse --short HEAD)"
  echo
  echo "Available versions in the submodule (most recent last):"
  available_versions | sed 's/^/  /'
  echo
  echo "Usage: scripts/update-spec <VERSION>"
  exit 0
fi

new_version="$1"

echo "Fetching latest spec submodule..."
git -C "$SUBMODULE" fetch --quiet origin
git -C "$SUBMODULE" checkout --quiet origin/HEAD

spec_file="$SPEC_DIR/${new_version}.json"
if [[ ! -f "$spec_file" ]]; then
  echo "error: spec $spec_file not found" >&2
  echo "  run scripts/update-spec with no args to list available versions" >&2
  exit 1
fi
if ! grep -qE "$README_PATTERN" "$README"; then
  echo "error: README.md no longer says 'Targets Network application version **X**'" >&2
  echo "  update README_PATTERN in this script to match the new wording" >&2
  exit 1
fi

current="$(current_version)"
if [[ "$current" == "$new_version" ]]; then
  echo "Already pinned to $new_version. Re-running checks anyway."
else
  echo "Bumping SPEC_VERSION: $current -> $new_version"
  sed -i.bak -E \
    "s|const SPEC_VERSION: &str = \"[^\"]+\"|const SPEC_VERSION: \&str = \"${new_version}\"|" \
    "$BUILD_RS"
  rm -f "${BUILD_RS}.bak"
fi
sed -i.bak -E \
  "s|$README_PATTERN|Targets Network application version **${new_version}**|" \
  "$README"
rm -f "${README}.bak"

# touching build.rs ensures cargo re-runs the build script even if its
# fingerprint thinks nothing changed
touch "$BUILD_RS"

run() {
  echo
  echo "==> $*"
  "$@"
}

run cargo build -p ferro-network
run cargo fmt --all -- --check
run cargo clippy --all-targets --all-features -- -D warnings
run cargo test --all
run cargo deny check

echo
echo "All checks passed."
echo "Submodule now at: $(git -C "$SUBMODULE" rev-parse --short HEAD)"
echo
echo "Next steps:"
echo "  git add third_party/unifi-apis ${BUILD_RS#"$REPO_ROOT"/} ${README#"$REPO_ROOT"/}"
echo "  git commit -m 'chore(spec): bump Network spec to $new_version'"
