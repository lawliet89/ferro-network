#!/usr/bin/env bash
# Run the ferro-network live integration tests against a real Network
# application.
#
# Sources .env.local (gitignored) if present, then runs the `live` test
# binary with `--features insecure-tls` and `--nocapture`. Extra arguments
# are passed to the test harness (e.g. a test-name filter).
#
# Live tests skip themselves when no target is configured. Mutating
# `live_write_*` tests additionally need UNIFI_NETWORK_ALLOW_MUTATIONS=1
# and must never run against a production site. See AGENT.md
# "Testing strategy".

set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

if [[ -f .env.local ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env.local
  set +a
fi

if [[ -z "${UNIFI_NETWORK_HOST:-}" && -z "${UNIFI_NETWORK_BASE_URL:-}" ]]; then
  echo "error: neither UNIFI_NETWORK_HOST nor UNIFI_NETWORK_BASE_URL is set." >&2
  echo "  Copy .env.example to .env.local and fill it in." >&2
  exit 1
fi

exec cargo test --features insecure-tls -p ferro-network --test live -- --nocapture "$@"
