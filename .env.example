# Copy to `.env.local` (gitignored) and fill in. A single `.env.local`
# drives both the CLI (`cargo run -p ferro-network-cli -- info`) and the
# live integration tests (`./scripts/live-test`). Source it with
# `set -a; source .env.local; set +a`, or with direnv, or by running
# `./scripts/live-test` (which does the sourcing for you).
#
# Precedence: env vars (set here) override the on-disk config file
# (`~/.config/ferro-network/config.toml`) but are themselves overridden
# by per-invocation CLI flags. The typical split is: config file for
# interactive use, this `.env.local` for tests. Live tests read only
# these env vars, never the config file.
# `UNIFI_NETWORK_CONFIG_FILE=<PATH>` selects a different config file.

# UniFi OS console host (or host:port) -- HOSTNAME ONLY, no scheme prefix.
# The client wraps this as https://{host}/proxy/network/integration.
# Right:   unifi.local          10.0.0.1            10.0.0.1:443
# Wrong:   https://unifi.local  http://10.0.0.1     unifi.local/something
UNIFI_NETWORK_HOST=unifi.local

# Preferred: point at a file containing only the API key.
UNIFI_NETWORK_API_KEY_FILE=$HOME/.config/ferro-network/api_key

# Alternative (less safe): raw key in the env var.
# UNIFI_NETWORK_API_KEY=paste-key-here

# Set to any non-empty value to skip TLS verification (self-signed consoles).
UNIFI_NETWORK_INSECURE=1

# Site for site-scoped commands and live tests: a site UUID or its
# `internalReference` (e.g. `default`). Unset means the `default` site,
# else the only site on the console.
# UNIFI_NETWORK_SITE=default

# Gate for mutating live tests (create/update/delete, device and client
# actions). Keep this commented out for routine runs. NEVER enable it
# against a production site: Network mutations can cut off the machine
# running the tests (networks, firewall, ACLs, WiFi, device restarts,
# PoE power-cycles).
# UNIFI_NETWORK_ALLOW_MUTATIONS=1

# Log filter for the CLI. Same syntax as env_logger's RUST_LOG. The
# `--log-level <level>` flag overrides this; absent both, RUST_LOG and
# then the literal default `warn` apply. Logs go to stderr.
# UNIFI_NETWORK_LOG=debug
